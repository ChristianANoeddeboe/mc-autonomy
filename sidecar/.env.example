# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Real exported environment variables take precedence over anything set here.

# Required when primary_provider = "openrouter"
OPENROUTER_API_KEY=

# Required when stub_mode = false and the primary provider is unavailable
ANTHROPIC_API_KEY=

# --- Optional overrides (otherwise sidecar_config.json / defaults apply) ---
# STUB_MODE=false
# PRIMARY_PROVIDER=openrouter
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_TIMEOUT=120
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:latest
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# SIDECAR_PORT=8765
# LOG_LEVEL=INFO
